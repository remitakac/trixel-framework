# TRIXEL Framework — Basic Usage Example
# ======================================
# Demonstration of SD, VD, VS computation and identity verification.

import numpy as np
from calibrators import compute_all, check_algebraic_identity, dominant_calibrator

# Synthetic Gaussian profile
S = np.linspace(0, 10, 500)
V = np.exp(-0.5 * ((S - 5) / 1.5) ** 2)
D = -np.gradient(V, S)

# Compute all calibrators
c = compute_all(V, D, S)

# Verify algebraic identity
err, holds = check_algebraic_identity(V, D, S)
print(f"Algebraic identity VD/VS = SD: {'HOLDS' if holds else 'FAILS'} (error = {err:.2e})")

# Dominant calibrator distribution
dom = dominant_calibrator(c['SD'], c['n'])
unique, counts = np.unique(dom, return_counts=True)
for d, n in zip(unique, counts):
    print(f"{d}: {n/len(dom)*100:.1f}%")

# Display ranges
print(f"\nVS range: {c['VS'].min():.4f} to {c['VS'].max():.4f}")
print(f"SD range: {c['SD'].min():.4f} to {c['SD'].max():.4f}")
